{% set selected_resources = [] %}
{% for location in locations %}
    {% set browse_url = '' %}
    {% set preview_url = '' %}
    {% set authenticated_location = location %}
    {% set browse_variation_name = 'browse' %}
    {% set preview_variation_name = 'preview' %}

    {% if location.remoteResource.protected %}
        {% set authenticated_location = ngrm_authenticate_remote_resource_location(location, 600) %}
        {% set browse_variation_name = browse_variation_name ~ '_protected' %}
        {% set preview_variation_name = preview_variation_name ~ '_protected' %}
    {% endif %}

    {% if location.remoteResource.type == 'image' %}
        {% set browse_variation_name = browse_variation_name ~ '_image' %}
        {% set preview_variation_name = preview_variation_name ~ '_image' %}
    {% endif %}

    {% if location.remoteResource.type == 'image' %}
        {% set browse_url = ngrm_remote_resource_variation(authenticated_location, 'ngrm_interface', browse_variation_name).url %}
        {% set preview_url = ngrm_remote_resource_variation(authenticated_location, 'ngrm_interface', preview_variation_name).url %}
    {% elseif location.remoteResource.type == 'video' %}
        {% set browse_url = ngrm_video_thumbnail_variation(authenticated_location, 'ngrm_interface', browse_variation_name).url %}
        {% set preview_url = ngrm_remote_resource_variation(authenticated_location, 'ngrm_interface', preview_variation_name).url %}
    {% endif %}

    {% set crop_settings = {} %}
    {% for crop_setting in location.cropSettings %}
        {% set crop_settings = crop_settings|merge({(crop_setting.variationName): {
            'x': crop_setting.x,
            'y': crop_setting.y,
            'w': crop_setting.width,
            'h': crop_setting.height
        }}) %}
    {% endfor %}

    {% set selected_resources = selected_resources|merge([{
        'id': location.remoteResource.remoteId ? location.remoteResource.remoteId : '',
        'locationId': location.id ? location.id : '',
        'name': location.remoteResource.name ? location.remoteResource.name : '',
        'type': location.remoteResource.type ? location.remoteResource.type : '',
        'format': location.remoteResource.metadata.format is defined ? location.remoteResource.metadata.format : '',
        'url': location.remoteResource.url ? location.remoteResource.url : '',
        'browseUrl': browse_url,
        'previewUrl': preview_url,
        'alternateText': location.remoteResource.altText ? location.remoteResource.altText : '',
        'caption': location.remoteResource.caption ? location.remoteResource.caption : '',
        'watermarkText': location.watermarkText ? location.watermarkText : '',
        'tags': location.remoteResource.tags,
        'size': location.remoteResource.size,
        'variations': crop_settings,
        'height': location.remoteResource.metadata.height is defined ? location.remoteResource.metadata.height : 0,
        'width': location.remoteResource.metadata.width is defined ? location.remoteResource.metadata.width : 0,
        'source': location.source ? location.source : location_source,
    }]) %}
{% endfor %}

{% set first_resource = selected_resources|length > 0 ? selected_resources|first : null %}
{% set selected_image = first_resource ? first_resource|merge({'uploadedResources': selected_resources}) : {
    'id': '',
    'locationId': '',
    'name': '',
    'type': 'image',
    'format': '',
    'url': '',
    'browseUrl': '',
    'previewUrl': '',
    'alternateText': '',
    'caption': '',
    'watermarkText': '',
    'tags': [],
    'size': 0,
    'variations': {},
    'height': 0,
    'width': 0,
    'source': location_source,
    'uploadedResources': []
} %}

{% set encoded_selected_image = selected_image|json_encode %}

<div
    class="ngremotemedia-container"
    data-id="{{ field_id }}"
    v-init:selected-image='{{ encoded_selected_image|e('html_attr') }}'
    v-init:config='{{ config|json_encode|e('html_attr') }}'
>
    <interactions
        field-id="{{ field_id }}"
        :config="config"
        :selected-image="selectedImage"
    ></interactions>
</div>
